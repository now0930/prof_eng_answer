# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# LLM provider selection
# auto   : Gemini primary, Clova fallback
# gemini : Gemini only
# clova  : Clova only
LLM_PROVIDER=auto
LLM_PRIMARY=gemini
LLM_FALLBACK=clova

# Naver CLOVA Studio
# 새 방식은 CLOVA_API_KEY만 사용한다.
# CLOVA_APIGW_API_KEY는 Legacy 방식이 필요할 때만 사용한다.
CLOVA_API_KEY=
CLOVA_REQUEST_ID=prof-eng-answer-local
CLOVA_MODEL=HCX-003
CLOVA_HOST=https://clovastudio.stream.ntruss.com
CLOVA_ENDPOINT=/v1/chat-completions/HCX-003

# Topic Router v2

# 아래 5개 gate를 true로 설정하면 Topic Router v2 전체 경로를 기본 활성화한다.
# 실제 운영값은 실행 환경의 .env에서 설정하고, 이 파일은 권장 기본값과 의미를 문서화한다.

# 문제를 D1, D2 ... 형태의 독립 요구사항으로 분해하여 이후 Router 판단의 입력으로 사용한다.
QUESTION_DEMAND_SHADOW_ENABLED=true

# 분해된 각 요구사항을 Topic Pack과 의미 기반으로 매핑하여 Topic 후보와 confidence를 생성한다.
SEMANTIC_ROUTER_SHADOW_ENABLED=true

# Rule Router와 Semantic Router 결과를 실제 grading routing decision에 반영한다.
ASSISTED_ROUTING_ENABLED=true

# 하나의 문제 요구사항들이 2개 이상의 Topic Pack에 걸치면 MULTI_TOPIC grading evidence를 구성한다.
# Topic별 점수를 합산하지 않고, 한 문제에 대해 하나의 A/B/C/D/E 점수만 산출한다.
MULTI_TOPIC_GRADING_ENABLED=true

# 일부 요구사항이 Topic Pack에 매핑되지 않은 경우,
# 매핑된 Topic evidence와 uncovered demand용 General evidence를 함께 사용한다.
HYBRID_GENERAL_GRADING_ENABLED=true
