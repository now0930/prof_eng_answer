{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prof-eng-answer.local/schemas/fact_grounded_contract_v1.schema.json",
  "title": "Fact-grounded grading inputs and immutable snapshot",
  "description": "Stage 1 proposal contracts. Score-neutral and not an active grading bank.",
  "oneOf": [
    {"$ref": "#/$defs/fact"},
    {"$ref": "#/$defs/question_contract"},
    {"$ref": "#/$defs/candidate"},
    {"$ref": "#/$defs/snapshot"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}
    },
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "predicate", "object", "conditions"],
      "properties": {
        "subject": {"$ref": "#/$defs/id"}, "predicate": {"$ref": "#/$defs/id"},
        "object": {"$ref": "#/$defs/id"}, "conditions": {"$ref": "#/$defs/ids"}
      }
    },
    "task": {"enum": ["define", "explain", "compare", "calculate", "design", "evaluate", "apply"]},
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_version", "source_sha256", "locator"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "fact_id", "topic_id", "statement", "relation", "source_refs", "review_status", "revision", "score_effect"],
      "properties": {
        "schema_version": {"const": "fact-grounded-contract-v1"},
        "fact_id": {"$ref": "#/$defs/id"}, "topic_id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "relation": {"$ref": "#/$defs/relation"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
        "review_status": {"enum": ["candidate", "approved", "conflict"]},
        "revision": {"type": "integer", "minimum": 1},
        "score_effect": {"const": "none"},
        "legacy_anchor_id": {"$ref": "#/$defs/id"}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "source_span", "source_text", "task", "fact_refs", "resolution"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/id"},
        "source_span": {"$ref": "#/$defs/span"},
        "source_text": {"type": "string", "minLength": 1},
        "task": {"$ref": "#/$defs/task"},
        "fact_refs": {"$ref": "#/$defs/ids"},
        "resolution": {"enum": ["resolved", "knowledge_gap", "ambiguous"]}
      }
    },
    "question_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "question_sha256", "knowledge_snapshot_sha256", "requirements", "score_effect"],
      "properties": {
        "schema_version": {"const": "fact-grounded-contract-v1"},
        "question_sha256": {"$ref": "#/$defs/sha"},
        "knowledge_snapshot_sha256": {"$ref": "#/$defs/sha"},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "score_effect": {"const": "none"}
      }
    },
    "question_proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "target_concepts", "conditions"],
      "properties": {
        "task": {"$ref": "#/$defs/task"},
        "target_concepts": {"$ref": "#/$defs/ids"},
        "conditions": {"$ref": "#/$defs/ids"}
      }
    },
    "claim_proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "predicate", "object", "conditions", "polarity", "assertion_context"],
      "properties": {
        "subject": {"$ref": "#/$defs/id"}, "predicate": {"$ref": "#/$defs/id"},
        "object": {"$ref": "#/$defs/id"}, "conditions": {"$ref": "#/$defs/ids"},
        "polarity": {"enum": ["positive", "negative"]},
        "assertion_context": {"enum": ["asserted", "quoted", "rejected", "corrected"]}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "kind", "source_span", "source_text", "proposal", "producer", "score_effect"],
      "properties": {
        "schema_version": {"const": "fact-grounded-contract-v1"},
        "candidate_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["question_requirement", "answer_claim"]},
        "source_span": {"$ref": "#/$defs/span"},
        "source_text": {"type": "string", "minLength": 1},
        "proposal": {"oneOf": [{"$ref": "#/$defs/question_proposal"}, {"$ref": "#/$defs/claim_proposal"}]},
        "producer": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "resolver_id", "resolver_version"],
          "properties": {
            "mode": {"enum": ["deterministic_parser", "semantic_resolver"]},
            "resolver_id": {"$ref": "#/$defs/id"},
            "resolver_version": {"type": "string", "minLength": 1}
          }
        },
        "score_effect": {"const": "none"}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "question_sha256", "answer_sha256", "facts_sha256", "question_contract_sha256", "candidates_sha256", "ontology_sha256", "rubric_source_sha256", "scoring_policy_version", "approved_fact_ids", "score_effect", "snapshot_sha256"],
      "properties": {
        "schema_version": {"const": "fact-grounded-contract-v1"},
        "question_sha256": {"$ref": "#/$defs/sha"},
        "answer_sha256": {"$ref": "#/$defs/sha"},
        "facts_sha256": {"$ref": "#/$defs/sha"},
        "question_contract_sha256": {"$ref": "#/$defs/sha"},
        "candidates_sha256": {"$ref": "#/$defs/sha"},
        "ontology_sha256": {"$ref": "#/$defs/sha"},
        "rubric_source_sha256": {"$ref": "#/$defs/sha"},
        "scoring_policy_version": {"type": "string", "minLength": 1},
        "approved_fact_ids": {"$ref": "#/$defs/ids"},
        "score_effect": {"const": "none"},
        "snapshot_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
