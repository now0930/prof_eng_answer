{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical_grading_evidence_v1.schema.json",
  "title": "Canonical Grading Evidence V1",
  "description": "Provider-neutral evidence only. It cannot carry grading authority.",
  "type": "object",
  "required": ["schema_version", "marker", "authority", "score_effect", "input_fingerprint", "source", "claims", "summary", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "marker": {"const": "CANONICAL_GRADING_EVIDENCE_V1"},
    "authority": {"const": "evidence_only"},
    "score_effect": {"const": "none"},
    "input_fingerprint": {
      "type": "object",
      "required": ["question_sha256", "answer_sha256"],
      "properties": {
        "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "answer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["mode", "resolver_id", "resolver_version"],
      "properties": {
        "mode": {"enum": ["deterministic_parser", "semantic_resolver", "human_adapter", "legacy_adapter"]},
        "resolver_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "resolver_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "subject", "predicate", "object", "polarity", "conditions", "assertion_context", "source_text", "source_span", "requirement_refs", "qualifiers", "extraction_confidence"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "object": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "polarity": {"enum": ["positive", "negative"]},
          "conditions": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
          "assertion_context": {"enum": ["asserted", "quoted", "rejected", "corrected"]},
          "source_text": {"type": "string", "minLength": 1},
          "source_span": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "requirement_refs": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
          "qualifiers": {"type": "object", "additionalProperties": {"type": "string"}},
          "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["claim_count"],
      "properties": {"claim_count": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
