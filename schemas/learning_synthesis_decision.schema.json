{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topic_id",
    "candidate_sha256",
    "base_master_sha256",
    "application",
    "reviews",
    "score_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "learning-synthesis-decision-v1"
    },
    "topic_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_master_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "actor",
        "actor_type",
        "decided_at"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "approve",
            "reject"
          ]
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_type": {
          "const": "human"
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "status",
          "actor",
          "actor_type",
          "decided_at",
          "note"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "llm_reviewed_human_pending",
              "human_verified",
              "rejected"
            ]
          },
          "actor": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor_type": {
            "enum": [
              "human",
              "llm"
            ]
          },
          "decided_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "score_effect": {
      "const": "none"
    }
  }
}
