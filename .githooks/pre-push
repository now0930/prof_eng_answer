#!/bin/sh
# Tip-tree check only; review outgoing history separately.
set -eu
cd "$(git rev-parse --show-toplevel)"
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        *[!0]*) python3 -B scripts/check_private_paths.py --tree "$local_oid" </dev/null ;;
    esac
done
